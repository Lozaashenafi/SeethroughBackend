# See Through Backend — Environment Variables
# Copy this file to .env and fill in the values

# Required: PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seethrough

# Server port (default: 4000)
# PORT=4000

# CORS origin (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173

# JWT secret for admin authentication
# REQUIRED in production. In development, a fallback is used with a warning.
# Generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-this

# Default admin credentials used by the seed script (pnpm db:seed)
# REQUIRED in production. The dev default is admin@seethrough.com / admin123.
# ADMIN_EMAIL=admin@seethrough.com
# ADMIN_PASSWORD=change-me-in-production

# Log level (default: info)
# LOG_LEVEL=info

# Node environment (default: development)
# NODE_ENV=development
