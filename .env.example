# See Through Backend — Environment Variables
# Copy this file to .env and fill in the values

# Required: PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/seethrough

# Server port (default: 4000)
# PORT=4000

# CORS origin (default: http://localhost:5173)
# IMPORTANT in production: add your DEPLOYED FRONTEND origin, e.g.
#   CORS_ORIGIN=https://yourfrontend.vercel.app
# Comma-separate multiple origins. Without this, deployed admin login fails.
# CORS_ORIGIN=http://localhost:5173

# JWT secret for admin authentication
# REQUIRED in production. In development, a fallback is used with a warning.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Default admin credentials used by the seed script (pnpm db:seed)
# REQUIRED in production. The dev default is admin@seethrough.com / admin123.
# ADMIN_EMAIL=admin@seethrough.com
# ADMIN_PASSWORD=change-me-in-production

# Log level (default: info)
# LOG_LEVEL=info

# Node environment (default: development)
# NODE_ENV=development

# Google OAuth Client ID
# Create one at: https://console.cloud.google.com/apis/credentials
# If not set, tokens won't be verified cryptographically (dev fallback)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SambaNova Cloud API key for AI review-title generation (https://cloud.sambanova.ai).
# OpenAI-compatible endpoint: https://api.sambanova.ai/v1
# If unset, the suggest-title endpoint returns a local heuristic fallback instead.
# SAMBANOVA_API_KEY=your-sambanova-api-key

# Review moderation alerts.
# Where "a review is waiting for moderation" emails go. Comma-separate several
# addresses (e.g. a team inbox). When unset, alerts are sent to every admin
# account that has a verified email.
# ADMIN_ALERT_EMAILS=moderation@yourdomain.com

# Resend API key for transactional emails (verification, password reset,
# moderation alerts). If unset, emails are logged and skipped instead of sent.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address for those emails. Must be on a domain verified in Resend.
# EMAIL_FROM=See Through <noreply@yourdomain.com>

# Frontend origin used to build links inside emails (verification, password
# reset, and the "approve or reject" deep link in moderation alerts).
# FRONTEND_URL=http://localhost:5173
# ADMIN_ALERT_EMAILS